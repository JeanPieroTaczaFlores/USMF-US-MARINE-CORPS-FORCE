{
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": ".",
  "installCommand": "cd app && npm install",
  "rewrites": [
    { "source": "/app/assets/(.*)", "destination": "/app/dist/assets/$1" },
    { "source": "/app/(.*)", "destination": "/app/dist/index.html" }
  ]
}
